# ── AI coach (server-side, optional) ──────────────────────────────
# Without this the app still works using the in-browser local coach.
ANTHROPIC_API_KEY=
COACH_MODEL=claude-haiku-4-5-20251001

# ── Voice transcription with Whisper (server-side, optional) ───────
# Much more accurate for accented English than the browser recognizer.
# Without this the app falls back to the browser's speech recognition.
OPENAI_API_KEY=
STT_MODEL=whisper-1

# ── Server ────────────────────────────────────────────────────────
PORT=8787

# ── Supabase cloud backup (frontend, optional) ────────────────────
# Baked into the build. Leave empty for local-only storage.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
