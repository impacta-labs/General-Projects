# ── AI coach (server-side, optional) ──────────────────────────────
# Without this the app still works using the in-browser local coach.
ANTHROPIC_API_KEY=
COACH_MODEL=claude-haiku-4-5-20251001

# ── Server ────────────────────────────────────────────────────────
PORT=8787

# ── Supabase cloud backup (frontend, optional) ────────────────────
# Baked into the build. Leave empty for local-only storage.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
